# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL 16 connection string. Required when NODE_ENV=production.
DATABASE_URL=postgres://mazzi:mazzi_dev_password@localhost:5432/mazzi

# Auth secrets, at least 32 characters each. Required in production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Deriv API (owner must supply). Demo app id and a demo API token.
DERIV_APP_ID=
DERIV_TOKEN=
DERIV_WS_ENDPOINT=wss://ws.derivws.com/websockets/v3

# Telegram alerts (owner must supply the bot token from BotFather and their chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Default operating mode. AUTOMATED is refused in this build.
TRADING_MODE=ALERT_ONLY

# Protected baseline zone. Must equal 0.5 and 0.618 or startup fails.
FIB_ZONE_LOWER=0.5
FIB_ZONE_UPPER=0.618
